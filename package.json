{
  "name": "pi-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Persönliche Zentrale von Jerome auf dem Raspberry Pi",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server/main.ts",
    "dev:web": "vite",
    "start": "node --disable-warning=ExperimentalWarning --max-old-space-size=200 dist/server/main.js",
    "start:demo": "DEMO_MODUS=true DATEN_TREIBER=lokal npm start",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings",
    "lint": "biome check src scripts test",
    "lint:fix": "biome check --write src scripts test",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec 'test/**/*.test.ts'",
    "pruefen": "npm run typecheck && npm run lint && npm test",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.ts",
    "db:generieren": "node --disable-warning=ExperimentalWarning scripts/migrationen-generieren.ts",
    "selbsttest": "node --disable-warning=ExperimentalWarning scripts/selbsttest.ts",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.ts",
    "passwort": "node --disable-warning=ExperimentalWarning scripts/passwort.ts",
    "deploy": "bash scripts/deploy.sh",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.10.0",
    "leaflet": "^1.9.4",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
