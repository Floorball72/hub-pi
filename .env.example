# Pi Hub Konfiguration
# Kopie als .env anlegen. Der Einrichtungsassistent (/einrichtung) füllt die Werte aus.
# Diese Datei enthält nur leere Werte oder harmlose Standards. Nie echte Schlüssel eintragen.

# Grundbetrieb
PORT=8080
# 0.0.0.0 = lokales Netz und Tailscale (Zugriff wird auf private Netze beschränkt), 127.0.0.1 = nur lokal
HOST=0.0.0.0
# Demo Modus: alle Quellen liefern Beispieldaten, Push wird nur protokolliert
DEMO_MODUS=false
# Datentreiber: lokal (SQLite) oder supabase
DATEN_TREIBER=lokal
# Verzeichnis für SQLite, Puffer und Backups (Standard: ./data)
DATEN_VERZEICHNIS=
# Zufälliger langer Wert, install.sh erzeugt ihn
SESSION_SECRET=
# Lokaler Login (Fallback, auch wenn Supabase nicht erreichbar ist). Hash mit: npm run passwort
ADMIN_BENUTZER=jerome
ADMIN_PASSWORT_HASH=
# Wird vom Einrichtungsassistenten auf true gesetzt
EINRICHTUNG_ABGESCHLOSSEN=false
# Zusätzliche erlaubte Netze (CIDR, mit Komma getrennt)
ERLAUBTE_NETZE=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres Verbindung (Supabase: Project Settings, Database, Connection string, Session pooler)
SUPABASE_DB_URL=
# E-Mail Adressen, die sich über Supabase Auth anmelden dürfen (mit Komma getrennt)
ERLAUBTE_EMAILS=

# ntfy
NTFY_SERVER=https://ntfy.sh
NTFY_THEMA=
NTFY_TOKEN=
# Adresse des Hubs, damit ein Tipp auf den Push die passende Seite öffnet (z.B. https://hub-pi.tailXXXX.ts.net)
HUB_ADRESSE=

# Orte: Name|Breite|Länge, mit Semikolon getrennt
WETTER_ORTE=Kirchberg SG|47.41079|9.04110;St. Gallen|47.42358|9.38851
# ÖV Haltestellen (Name wie bei transport.opendata.ch), mit Semikolon getrennt
OEV_HALTESTELLEN=Kirchberg SG, Post;St. Gallen

# Kalender (geheime iCal Adresse aus Google Kalender)
ICAL_URL=

# Rettung: Region als Mittelpunkt und Radius in km
REGION_NAME=Ostschweiz
REGION_LAT=47.41
REGION_LON=9.20
REGION_RADIUS_KM=40
# Zusätzliche öffentliche RSS Quellen für Einsatzmeldungen: Name|URL, mit Semikolon getrennt
# (die Medienmitteilungen der Stadtpolizei St.Gallen sind eingebaut)
EINSATZ_FEEDS=
# Gebiete für Unwetterwarnungen (Teil des Gebietsnamens bei MeteoAlarm), mit Semikolon getrennt
WARN_GEBIETE=St. Gallen;Appenzell;Thurgau;Toggenburg
# Alle Helikopter in der Region zeigen (true) oder nur die Kennzeichen aus der Liste (false)
HELI_ALLE=true
# Typen für die schweizweite Abfrage (Rega: A109 = AW109SP, EC45 = H145; Air Zermatt, Air Glaciers: AS50 = H125, EC35, B429, LAMA). Leer = nur Region
HELI_TYPEN=A109,EC45,A169,AS50,EC30,EC35,B429,LAMA

# Updates: nur aus diesem Repository und Branch
UPDATE_REPO=Floorball72/hub-pi
UPDATE_BRANCH=main

# Optionale Schlüssel
PAGESPEED_API_KEY=
# Have I Been Pwned (optional, kostenpflichtig): nur für verifizierte eigene Domains
HIBP_API_KEY=
# GitHub Token nur mit Leserecht (Contents: read) für private Repositories im Abhängigkeits Wächter und für Updates
GITHUB_TOKEN=
# TheSportsDB Schlüssel (leer = freier Testschlüssel 123 mit Einschränkungen)
THESPORTSDB_KEY=

# swiss unihockey: geteilter Hub Login. Nur hier eintragen, wird nirgends ausgegeben.
SUH_LOGIN_BENUTZER=
SUH_LOGIN_PASSWORT=

# Deploy vom Laptop
DEPLOY_ZIEL=scont@hub-pi.local
DEPLOY_PFAD=/opt/pihub

# Jarvis (KI Assistent). Ein Schlüssel genügt. Gratis: GEMINI_API_KEY (aistudio.google.com) oder GROQ_API_KEY (console.groq.com).
# Bezahlt: ANTHROPIC_API_KEY (console.anthropic.com). JARVIS_ANBIETER (claude, gemini, groq) nur nötig, wenn mehrere Schlüssel gesetzt sind.
GEMINI_API_KEY=
GROQ_API_KEY=
JARVIS_ANBIETER=
ANTHROPIC_API_KEY=
JARVIS_MODELL=
JARVIS_MODELL_SCHNELL=
